{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPN Client",
  "version": "0.1.0",
  "identifier": "com.gpn.client",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GPN Client",
        "width": 1280,
        "height": 820,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#0a0e0a",
        "dragDropEnabled": true,
        "resizable": false,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}